{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "HeyBurrito",
    "description": "A fun way to recognize and reward team members with virtual burritos! 🌯",
    "long_description": "HeyBurrito is a Slack app that allows team members to give virtual burritos to each other as a form of recognition and appreciation. Track contributions, view leaderboards, and build a positive team culture with this engaging reward system. Features include slash commands for giving burritos, emoji reactions for quick recognition, and comprehensive leaderboards to celebrate top contributors.",
    "background_color": "#FF6B35"
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://heyburrito-production.up.railway.app/slack/events",
      "bot_events": [
        "app_home_opened",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "reaction_added",
        "reaction_removed"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://heyburrito-production.up.railway.app/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "HeyBurrito",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/burrito",
        "description": "Give a burrito to a team member as recognition",
        "usage_hint": "/burrito @username [optional message]",
        "url": "https://heyburrito-production.up.railway.app/slack/commands"
      },
      {
        "command": "/leaderboard",
        "description": "View the burrito leaderboard to see top contributors",
        "usage_hint": "/leaderboard",
        "url": "https://heyburrito-production.up.railway.app/slack/commands"
      },
      {
        "command": "/cumpleanos",
        "description": "Manage team birthdays and greet whoever is celebrating",
        "usage_hint": "/cumpleanos set|add|remove|list|next|today|announce",
        "url": "https://heyburrito-production.up.railway.app/slack/commands"
      },
      {
        "command": "/birthday",
        "description": "Manage team birthdays and greet whoever is celebrating",
        "usage_hint": "/birthday set|add|remove|list|next|today|announce",
        "url": "https://heyburrito-production.up.railway.app/slack/commands"
      }
    ]
  },
  "oauth_config": {
    "redirect_urls": [
      "https://heyburrito-production.up.railway.app/slack/auth"
    ],
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "chat:write.public",
        "commands",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "reactions:read",
        "reactions:write",
        "users:read",
        "users:read.email"
      ]
    }
  }
}
